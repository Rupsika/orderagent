# Gemini API key used by the LangGraph agent
GOOGLE_API_KEY=your-gemini-api-key

# Secret used to sign JWT session tokens — set a long random value in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# SQLAlchemy database URL (defaults to a local SQLite file)
DATABASE_URL=sqlite:///./order_support.db
